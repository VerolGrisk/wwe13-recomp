+// macOS / iOS: no /proc. Walks the task's Mach threads; ids are the low 32 bits of the 64-bit
+// thread id, as rex::thread::current_thread_system_id returns. Times are in microseconds.
+struct MachThreadInfo {
+  uint32_t tid = 0;
+  std::string name;
+  uint64_t user_us = 0;
+  uint64_t system_us = 0;
+};
+
+template <typename Fn>
+void ForEachMachThread(Fn&& fn) {
+  thread_act_array_t threads = nullptr;
+  mach_msg_type_number_t count = 0;
+  if (task_threads(mach_task_self(), &threads, &count) != KERN_SUCCESS) {
+    return;
+  }
+  for (mach_msg_type_number_t i = 0; i < count; ++i) {
+    thread_identifier_info_data_t id_info{};
+    mach_msg_type_number_t id_count = THREAD_IDENTIFIER_INFO_COUNT;
+    thread_extended_info_data_t ext_info{};
+    mach_msg_type_number_t ext_count = THREAD_EXTENDED_INFO_COUNT;
+    if (thread_info(threads[i], THREAD_IDENTIFIER_INFO, reinterpret_cast<thread_info_t>(&id_info),
+                    &id_count) == KERN_SUCCESS &&
+        thread_info(threads[i], THREAD_EXTENDED_INFO, reinterpret_cast<thread_info_t>(&ext_info),
+                    &ext_count) == KERN_SUCCESS) {
+      MachThreadInfo info;
+      info.tid = static_cast<uint32_t>(id_info.thread_id);
+      info.name = ext_info.pth_name[0] ? std::string(ext_info.pth_name) : std::string("?");
+      // pth_user_time / pth_system_time are in Mach absolute-time units (24 MHz ticks on Apple
+      // silicon, nanoseconds on Intel), not nanoseconds.
+      static const mach_timebase_info_data_t timebase = [] {
+        mach_timebase_info_data_t value{};
+        mach_timebase_info(&value);
+        return value;
+      }();
+      info.user_us = ext_info.pth_user_time * timebase.numer / timebase.denom / 1000;
+      info.system_us = ext_info.pth_system_time * timebase.numer / timebase.denom / 1000;
+      fn(info);
+    }
+    mach_port_deallocate(mach_task_self(), threads[i]);
+  }
+  vm_deallocate(mach_task_self(), reinterpret_cast<vm_address_t>(threads),
+                count * sizeof(thread_act_t));
+}
+#endif
