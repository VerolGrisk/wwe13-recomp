@@ -449,8 +440,44 @@ class PosixConditionBase {
  protected:
   inline virtual bool signaled() const = 0;
   inline virtual void post_execution() = 0;
+
+  // A thread blocked in WaitMultiple on this handle among others.
+  struct MultiWaiter {
+    std::mutex mutex;
+    std::condition_variable cond;
+    uint64_t generation = 0;  // Protected by mutex.
+  };
+
+  // Locks mutex_ (recovering a robust mutex whose owner died, on Linux).
+  std::unique_lock<std::mutex> LockState() {
+#if REX_PLATFORM_LINUX
+    auto native_mutex = static_cast<pthread_mutex_t*>(mutex_.native_handle());
+    int lock_result = pthread_mutex_lock(native_mutex);
+    if (lock_result == EOWNERDEAD) {
+      pthread_mutex_consistent(native_mutex);
+    }
+    return std::unique_lock<std::mutex>(mutex_, std::adopt_lock);
+#else
+    return std::unique_lock<std::mutex>(mutex_);
+#endif
+  }
+
+  // Wakes single-handle waiters and multi-handle waiters. Call with mutex_ held, after the
+  // state change.
+  void NotifyAll() {
+    cond_.notify_all();
+    for (MultiWaiter* waiter : waiters_) {
+      {
+        std::lock_guard<std::mutex> lock(waiter->mutex);
+        ++waiter->generation;
+      }
+      waiter->cond.notify_all();
+    }
+  }
+
   std::condition_variable cond_;
   std::mutex mutex_;
+  std::vector<MultiWaiter*> waiters_;  // Protected by mutex_.
 };
 
