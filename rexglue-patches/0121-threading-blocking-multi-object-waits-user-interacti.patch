+
+// Multi-object waits block until a handle changes state (no polling) and keep Windows semantics:
+// WaitAny returns the lowest signaled index, WaitAll needs every handle, timeouts are honoured.
+TEST_CASE("WaitAny wakes on the handle that is signaled later", "[threading][wait_multiple]") {
+  auto a = rex::thread::Event::CreateAutoResetEvent(false);
+  auto b = rex::thread::Event::CreateAutoResetEvent(false);
+  std::thread signaler([&] {
+    std::this_thread::sleep_for(20ms);
+    b->Set();
+  });
+  const auto start = std::chrono::steady_clock::now();
+  auto result = rex::thread::WaitAny({a.get(), b.get()}, false, 2000ms);
+  const auto elapsed = std::chrono::steady_clock::now() - start;
+  signaler.join();
+  REQUIRE(result.first == WaitResult::kSuccess);
+  REQUIRE(result.second == 1);
+  REQUIRE(elapsed < 1000ms);
+  // Auto-reset: consumed by the wait.
+  REQUIRE(rex::thread::WaitAny({a.get(), b.get()}, false, 0ms).first == WaitResult::kTimeout);
+}
+
+TEST_CASE("WaitAny returns the lowest signaled index", "[threading][wait_multiple]") {
+  auto a = rex::thread::Event::CreateManualResetEvent(false);
+  auto b = rex::thread::Event::CreateManualResetEvent(true);
+  auto c = rex::thread::Event::CreateManualResetEvent(true);
+  auto result = rex::thread::WaitAny({a.get(), b.get(), c.get()}, false, 0ms);
+  REQUIRE(result.first == WaitResult::kSuccess);
+  REQUIRE(result.second == 1);
+}
+
+TEST_CASE("WaitAll waits for every handle", "[threading][wait_multiple]") {
+  auto a = rex::thread::Event::CreateManualResetEvent(true);
+  auto b = rex::thread::Semaphore::Create(0, 4);
+  REQUIRE(rex::thread::WaitAll({a.get(), b.get()}, false, 30ms) == WaitResult::kTimeout);
+  std::thread releaser([&] {
+    std::this_thread::sleep_for(20ms);
+    b->Release(1, nullptr);
+  });
+  REQUIRE(rex::thread::WaitAll({a.get(), b.get()}, false, 2000ms) == WaitResult::kSuccess);
+  releaser.join();
+  // The semaphore count was taken by the wait.
+  REQUIRE(rex::thread::WaitAll({a.get(), b.get()}, false, 0ms) == WaitResult::kTimeout);
+}
+
+TEST_CASE("WaitAny times out and sleeps instead of spinning", "[threading][wait_multiple]") {
+  auto a = rex::thread::Event::CreateAutoResetEvent(false);
+  auto b = rex::thread::Event::CreateAutoResetEvent(false);
+  const std::clock_t cpu_start = std::clock();
+  const auto start = std::chrono::steady_clock::now();
+  for (int i = 0; i < 100; ++i) {  // 100 x 1 ms, the alertable slice the kernel waits use.
+    REQUIRE(rex::thread::WaitAny({a.get(), b.get()}, false, 1ms).first == WaitResult::kTimeout);
+  }
+  const auto elapsed = std::chrono::steady_clock::now() - start;
+  const double cpu_ms = 1000.0 * double(std::clock() - cpu_start) / CLOCKS_PER_SEC;
+  REQUIRE(elapsed >= 100ms);
+  // A polling wait burns about as much CPU as wall time; a blocking one a small fraction.
+  REQUIRE(cpu_ms < 0.5 * std::chrono::duration<double, std::milli>(elapsed).count());
+}
+
+TEST_CASE("WaitAny under concurrent signaling delivers every release", "[threading][wait_multiple]") {
+  auto a = rex::thread::Semaphore::Create(0, 1 << 20);
+  auto b = rex::thread::Semaphore::Create(0, 1 << 20);
+  constexpr int kReleases = 20000;
+  std::thread producer_a([&] { for (int i = 0; i < kReleases; ++i) a->Release(1, nullptr); });
+  std::thread producer_b([&] { for (int i = 0; i < kReleases; ++i) b->Release(1, nullptr); });
+  int taken = 0;
+  while (taken < 2 * kReleases) {
+    auto result = rex::thread::WaitAny({a.get(), b.get()}, false, 2000ms);
+    REQUIRE(result.first == WaitResult::kSuccess);
+    ++taken;
+  }
+  producer_a.join();
+  producer_b.join();
+  REQUIRE(rex::thread::WaitAny({a.get(), b.get()}, false, 0ms).first == WaitResult::kTimeout);
+}
