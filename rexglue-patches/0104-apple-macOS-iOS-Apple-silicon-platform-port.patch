+VirtualKey TranslateSDLKeycodeToVirtualKey(SDL_Keycode key) {
+  if (key >= SDLK_A && key <= SDLK_Z) {
+    return VirtualKey(uint16_t(VirtualKey::kA) + uint16_t(key - SDLK_A));
+  }
+  if (key >= SDLK_0 && key <= SDLK_9) {
+    return VirtualKey(uint16_t(VirtualKey::k0) + uint16_t(key - SDLK_0));
+  }
+  if (key >= SDLK_F1 && key <= SDLK_F12) {
+    return VirtualKey(uint16_t(VirtualKey::kF1) + uint16_t(key - SDLK_F1));
+  }
+  if (key >= SDLK_F13 && key <= SDLK_F24) {
+    return VirtualKey(uint16_t(VirtualKey::kF13) + uint16_t(key - SDLK_F13));
+  }
+  if (key >= SDLK_KP_1 && key <= SDLK_KP_9) {
+    return VirtualKey(uint16_t(VirtualKey::kNumpad1) + uint16_t(key - SDLK_KP_1));
+  }
+  switch (key) {
+    case SDLK_KP_0:
+      return VirtualKey::kNumpad0;
+    case SDLK_ESCAPE:
+      return VirtualKey::kEscape;
+    case SDLK_RETURN:
