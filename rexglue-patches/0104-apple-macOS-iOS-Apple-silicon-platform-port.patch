+# Enforce Clang18 compiler. On Apple platforms Xcode's compiler reports itself as AppleClang with
+# its own version numbers; AppleClang 16 (Xcode 16) is the LLVM 17/18-era release with the C++23
+# library support ReXGlue needs, and Xcode's compiler is required for iOS builds.
+if(APPLE AND CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
+    if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS "16.0")
+        message(FATAL_ERROR "ReXGlue requires AppleClang 16 (Xcode 16) or newer (found ${CMAKE_CXX_COMPILER_VERSION})")
+    endif()
+elseif(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
     message(FATAL_ERROR "ReXGlue requires Clang compiler. Please set CMAKE_CXX_COMPILER to clang++")
-endif()
-
-if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS "18.0")
+elseif(CMAKE_CXX_COMPILER_VERSION VERSION_LESS "18.0")
     message(FATAL_ERROR "ReXGlue requires Clang 18 or newer (found ${CMAKE_CXX_COMPILER_VERSION})")
 endif()
 
