+// be async-signal-safe. Linux/Android: unnamed POSIX semaphores. Darwin does not implement
+// sem_init (it fails with ENOSYS), so use Mach semaphores, whose signal/wait are Mach traps and
+// safe in signal handlers. Return values follow sem_*: 0 on success, -1 with errno set.
+#if REX_PLATFORM_MAC
+using SuspendSem = semaphore_t;
+static inline void SuspendSemInit(SuspendSem* sem) {
+  if (semaphore_create(mach_task_self(), sem, SYNC_POLICY_FIFO, 0) != KERN_SUCCESS) {
+    *sem = MACH_PORT_NULL;
+  }
+}
+static inline void SuspendSemDestroy(SuspendSem* sem) {
+  if (*sem != MACH_PORT_NULL) {
+    semaphore_destroy(mach_task_self(), *sem);
+    *sem = MACH_PORT_NULL;
+  }
+}
+static inline int SuspendSemPost(SuspendSem* sem) {
+  return semaphore_signal(*sem) == KERN_SUCCESS ? 0 : (errno = EINVAL, -1);
+}
+static inline int SuspendSemWait(SuspendSem* sem) {
+  const kern_return_t kr = semaphore_wait(*sem);
+  if (kr == KERN_SUCCESS) {
+    return 0;
+  }
+  errno = kr == KERN_ABORTED ? EINTR : EINVAL;
+  return -1;
+}
+static inline int SuspendSemTryWait(SuspendSem* sem) {
+  const mach_timespec_t zero = {0, 0};
