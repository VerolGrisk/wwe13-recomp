+bool SDLWindow::OpenImpl() {
+  SDL_WindowFlags flags = SDL_WINDOW_METAL | SDL_WINDOW_HIGH_PIXEL_DENSITY | SDL_WINDOW_RESIZABLE;
+#if defined(TARGET_OS_IOS) && TARGET_OS_IOS
+  // iOS apps always cover the screen.
+  flags |= SDL_WINDOW_FULLSCREEN | SDL_WINDOW_BORDERLESS;
+#else
+  if (IsFullscreen()) {
+    flags |= SDL_WINDOW_FULLSCREEN;
+  }
+#endif
+  window_ = SDL_CreateWindow(GetTitle().c_str(), int(GetDesiredLogicalWidth()),
+                             int(GetDesiredLogicalHeight()), flags);
+  if (!window_) {
+    REXLOG_ERROR("SDLWindow: SDL_CreateWindow failed: {}", SDL_GetError());
+    return false;
+  }
+  window_id_ = SDL_GetWindowID(window_);
+
+  SDL_MetalView metal_view = SDL_Metal_CreateView(window_);
+  if (!metal_view) {
+    REXLOG_ERROR("SDLWindow: SDL_Metal_CreateView failed: {}", SDL_GetError());
+    SDL_DestroyWindow(window_);
+    window_ = nullptr;
+    return false;
+  }
+  metal_view_ = metal_view;
+  metal_layer_ = SDL_Metal_GetLayer(metal_view);
+
+  // Move to the requested monitor (1-based, as on the other platforms).
+  if (int32_t monitor_index = REXCVAR_GET(monitor); monitor_index > 0) {
+    int display_count = 0;
+    SDL_DisplayID* displays = SDL_GetDisplays(&display_count);
+    if (displays) {
+      if (monitor_index <= display_count) {
+        SDL_DisplayID display = displays[monitor_index - 1];
+        SDL_SetWindowPosition(window_, SDL_WINDOWPOS_CENTERED_DISPLAY(display),
+                              SDL_WINDOWPOS_CENTERED_DISPLAY(display));
+      }
+      SDL_free(displays);
+    }
+  }
+
+  sdl_app_context().RegisterWindow(window_id_, this);
+
+  // Text input delivers typed characters (OnKeyChar) for the in-game keyboard and Ctrl+V paste.
+  SDL_StartTextInput(window_);
+
+  SDL_ShowWindow(window_);
+
+  // Report the initial state regardless of which events SDL sends first.
+  {
+    WindowDestructionReceiver destruction_receiver(this);
+    ReportActualSize(destruction_receiver);
+    if (destruction_receiver.IsWindowDestroyedOrClosed()) {
+      return true;
+    }
+    if (SDL_GetWindowFlags(window_) & SDL_WINDOW_INPUT_FOCUS) {
+      OnFocusUpdate(true, destruction_receiver);
+      if (destruction_receiver.IsWindowDestroyedOrClosed()) {
+        return true;
+      }
+    }
+  }
+  return true;
+}
+
+void SDLWindow::RequestCloseImpl() {
+  CloseFromSDL();
+}
+
+void SDLWindow::HandleQuitRequest() {
+  CloseFromSDL();
+}
+
+void SDLWindow::CloseFromSDL() {
+  if (!window_) {
+    return;
+  }
+  WindowDestructionReceiver destruction_receiver(this);
+  OnBeforeClose(destruction_receiver);
+  if (destruction_receiver.IsWindowDestroyed()) {
+    return;
+  }
+  sdl_app_context().UnregisterWindow(window_id_);
+  if (metal_view_) {
+    SDL_Metal_DestroyView(static_cast<SDL_MetalView>(metal_view_));
+    metal_view_ = nullptr;
+    metal_layer_ = nullptr;
+  }
+  SDL_Window* window = window_;
+  window_ = nullptr;
+  SDL_DestroyWindow(window);
+  OnAfterClose();
+}
+
+void SDLWindow::ApplyNewFullscreen() {
+#if !(defined(TARGET_OS_IOS) && TARGET_OS_IOS)
+  WindowDestructionReceiver destruction_receiver(this);
+  // Borderless "desktop" fullscreen (no display mode change), which also behaves well with
+  // Spaces on macOS.
+  SDL_SetWindowFullscreenMode(window_, nullptr);
+  SDL_SetWindowFullscreen(window_, IsFullscreen());
+  SDL_SyncWindow(window_);
+  ReportActualSize(destruction_receiver);
+#endif
+}
+
+void SDLWindow::ApplyNewTitle() {
+  SDL_SetWindowTitle(window_, GetTitle().c_str());
+}
+
+void SDLWindow::FocusImpl() {
+  SDL_RaiseWindow(window_);
+}
+
+void SDLWindow::ApplyCursorHidden(bool hidden) {
+  if (hidden == cursor_hidden_) {
+    return;
+  }
+  cursor_hidden_ = hidden;
+  if (hidden) {
+    SDL_HideCursor();
+  } else {
+    SDL_ShowCursor();
+  }
+}
+
+void SDLWindow::ApplyNewCursorVisibility(CursorVisibility old_cursor_visibility) {
+  (void)old_cursor_visibility;
+  switch (GetCursorVisibility()) {
+    case CursorVisibility::kVisible:
+      ApplyCursorHidden(false);
+      break;
+    case CursorVisibility::kHidden:
+    case CursorVisibility::kAutoHidden:
+      // Entering auto-hide hides the cursor at once; movement reveals it (see HandleMouse).
+      ApplyCursorHidden(true);
+      break;
+  }
+}
+
+std::unique_ptr<Surface> SDLWindow::CreateSurfaceImpl(Surface::TypeFlags allowed_types) {
+  if ((allowed_types & Surface::kTypeFlag_MetalLayer) && metal_layer_) {
+    return std::make_unique<MetalLayerSurface>(window_, metal_layer_);
+  }
+  REXLOG_ERROR("SDLWindow: no supported surface type (need a Metal layer for MoltenVK)");
+  return nullptr;
+}
+
+void SDLWindow::RequestPaintImpl() {
+  if (window_) {
+    sdl_app_context().RequestPaint(window_id_);
+  }
+}
+
+void SDLWindow::HandlePaintEvent() {
+  if (!window_) {
+    return;
+  }
+  // Cursor auto-hide check rides on paints, which keep coming while the game runs.
+  if (GetCursorVisibility() == CursorVisibility::kAutoHidden && !cursor_hidden_ &&
+      SDL_GetTicks() - cursor_last_activity_ms_ >= kDefaultCursorAutoHideMilliseconds) {
+    ApplyCursorHidden(true);
+  }
+  OnPaint();
+}
+
+void SDLWindow::ReportActualSize(WindowDestructionReceiver& destruction_receiver) {
+  int width = 0, height = 0;
+  if (!SDL_GetWindowSizeInPixels(window_, &width, &height)) {
+    return;
+  }
+  OnActualSizeUpdate(uint32_t(std::max(width, 0)), uint32_t(std::max(height, 0)),
+                     destruction_receiver);
+}
+
+void SDLWindow::HandleEvent(const SDL_Event& event) {
+  if (!window_) {
+    return;
+  }
+  WindowDestructionReceiver destruction_receiver(this);
+  switch (event.type) {
+    case SDL_EVENT_WINDOW_CLOSE_REQUESTED:
+      CloseFromSDL();
+      return;
+    case SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED:
+    case SDL_EVENT_WINDOW_RESIZED:
+    case SDL_EVENT_WINDOW_ENTER_FULLSCREEN:
+    case SDL_EVENT_WINDOW_LEAVE_FULLSCREEN:
+      if (event.type == SDL_EVENT_WINDOW_ENTER_FULLSCREEN ||
+          event.type == SDL_EVENT_WINDOW_LEAVE_FULLSCREEN) {
+        // Keep the Window's notion in sync when the user toggles it from the OS (green button).
+        OnDesiredFullscreenUpdate(event.type == SDL_EVENT_WINDOW_ENTER_FULLSCREEN);
+      }
+      ReportActualSize(destruction_receiver);
+      if (!destruction_receiver.IsWindowDestroyedOrClosed()) {
+        RequestPaint();
+      }
+      return;
+    case SDL_EVENT_WINDOW_DISPLAY_SCALE_CHANGED: {
+      UISetupEvent e(this);
+      OnDpiChanged(e, destruction_receiver);
+      if (!destruction_receiver.IsWindowDestroyedOrClosed()) {
+        ReportActualSize(destruction_receiver);
+      }
+      return;
+    }
+    case SDL_EVENT_WINDOW_DISPLAY_CHANGED: {
+      MonitorUpdateEvent e(this, false);
+      OnMonitorUpdate(e);
+      return;
+    }
+    case SDL_EVENT_WINDOW_EXPOSED:
+      OnPaint();
+      return;
+    case SDL_EVENT_WINDOW_FOCUS_GAINED:
+      OnFocusUpdate(true, destruction_receiver);
+      return;
+    case SDL_EVENT_WINDOW_FOCUS_LOST:
+      OnFocusUpdate(false, destruction_receiver);
+      return;
+    case SDL_EVENT_KEY_DOWN:
+    case SDL_EVENT_KEY_UP:
+    case SDL_EVENT_TEXT_INPUT:
+      HandleKeyboard(event, destruction_receiver);
+      return;
+    case SDL_EVENT_MOUSE_MOTION:
+    case SDL_EVENT_MOUSE_BUTTON_DOWN:
+    case SDL_EVENT_MOUSE_BUTTON_UP:
+    case SDL_EVENT_MOUSE_WHEEL:
+      HandleMouse(event, destruction_receiver);
+      return;
+    case SDL_EVENT_FINGER_DOWN:
+    case SDL_EVENT_FINGER_UP:
+    case SDL_EVENT_FINGER_MOTION:
+    case SDL_EVENT_FINGER_CANCELED:
+      HandleTouch(event, destruction_receiver);
+      return;
+    case SDL_EVENT_DROP_FILE:
+      if (event.drop.data) {
+        FileDropEvent e(this, std::filesystem::path(event.drop.data));
+        OnFileDrop(e, destruction_receiver);
+      }
+      return;
+    default:
+      return;
+  }
+}
+
+void SDLWindow::HandleKeyboard(const SDL_Event& event,
+                               WindowDestructionReceiver& destruction_receiver) {
+  const SDL_Keymod mod = SDL_GetModState();
+  const bool shift = mod & SDL_KMOD_SHIFT;
+  const bool ctrl = mod & SDL_KMOD_CTRL;
+  const bool alt = mod & SDL_KMOD_ALT;
+  const bool super = mod & SDL_KMOD_GUI;
+  if (event.type == SDL_EVENT_TEXT_INPUT) {
+    // One OnKeyChar per code point, as GTK and Win32 deliver them.
+    const char* p = event.text.text;
+    while (p) {
+      const uint32_t cp = NextUtf8CodePoint(p);
+      if (!cp) {
+        break;
+      }
+      if (cp > 0xFFFF) {
+        continue;  // VirtualKey is 16-bit; the game's keyboard has no characters outside the BMP.
+      }
+      KeyEvent char_event(this, VirtualKey(uint16_t(cp)), 1, false, shift, ctrl, alt, super);
+      OnKeyChar(char_event, destruction_receiver);
+      if (destruction_receiver.IsWindowDestroyedOrClosed()) {
+        return;
+      }
+    }
+    return;
+  }
+  const bool down = event.type == SDL_EVENT_KEY_DOWN;
+  KeyEvent e(this, TranslateSDLKeycodeToVirtualKey(event.key.key), 1,
+             down ? event.key.repeat : true, shift, ctrl, alt, super);
+  if (down) {
+    OnKeyDown(e, destruction_receiver);
+  } else {
+    OnKeyUp(e, destruction_receiver);
+  }
+}
+
+void SDLWindow::HandleMouse(const SDL_Event& event,
+                            WindowDestructionReceiver& destruction_receiver) {
+  // SDL reports window coordinates in points; convert to pixels to match the reported size.
+  const float density = std::max(SDL_GetWindowPixelDensity(window_), 1.0f);
+  MouseEvent::Button button = MouseEvent::Button::kNone;
+  float x = 0.0f, y = 0.0f;
+  int32_t scroll_x = 0, scroll_y = 0;
+  switch (event.type) {
+    case SDL_EVENT_MOUSE_MOTION:
+      x = event.motion.x;
+      y = event.motion.y;
+      break;
+    case SDL_EVENT_MOUSE_BUTTON_DOWN:
+    case SDL_EVENT_MOUSE_BUTTON_UP:
+      switch (event.button.button) {
+        case SDL_BUTTON_LEFT:
+          button = MouseEvent::Button::kLeft;
+          break;
+        case SDL_BUTTON_MIDDLE:
+          button = MouseEvent::Button::kMiddle;
+          break;
+        case SDL_BUTTON_RIGHT:
+          button = MouseEvent::Button::kRight;
+          break;
+        case SDL_BUTTON_X1:
+          button = MouseEvent::Button::kX1;
+          break;
+        case SDL_BUTTON_X2:
+          button = MouseEvent::Button::kX2;
+          break;
+        default:
+          break;
+      }
+      x = event.button.x;
+      y = event.button.y;
+      break;
+    case SDL_EVENT_MOUSE_WHEEL: {
+      x = event.wheel.mouse_x;
+      y = event.wheel.mouse_y;
+      const float sign = event.wheel.direction == SDL_MOUSEWHEEL_FLIPPED ? -1.0f : 1.0f;
+      scroll_x = int32_t(std::lround(sign * event.wheel.x * MouseEvent::kScrollPerDetent));
+      // SDL: positive y is away from the user, as the Window API expects.
+      scroll_y = int32_t(std::lround(sign * event.wheel.y * MouseEvent::kScrollPerDetent));
+    } break;
+    default:
+      return;
+  }
+
+  // Any real mouse activity reveals an auto-hidden cursor and restarts its timer.
+  cursor_last_activity_ms_ = SDL_GetTicks();
+  if (GetCursorVisibility() == CursorVisibility::kAutoHidden) {
+    ApplyCursorHidden(false);
+  }
+
+  MouseEvent e(this, button, int32_t(std::lround(x * density)), int32_t(std::lround(y * density)),
+               scroll_x, scroll_y);
+  switch (event.type) {
+    case SDL_EVENT_MOUSE_MOTION:
+      OnMouseMove(e, destruction_receiver);
+      break;
+    case SDL_EVENT_MOUSE_BUTTON_DOWN:
+      OnMouseDown(e, destruction_receiver);
+      break;
+    case SDL_EVENT_MOUSE_BUTTON_UP:
+      OnMouseUp(e, destruction_receiver);
+      break;
+    case SDL_EVENT_MOUSE_WHEEL:
+      OnMouseWheel(e, destruction_receiver);
+      break;
+    default:
+      break;
+  }
+}
+
+void SDLWindow::HandleTouch(const SDL_Event& event,
+                            WindowDestructionReceiver& destruction_receiver) {
+  // SDL finger coordinates are normalized (0..1) to the window; the Window API wants pixels.
+  int width = 0, height = 0;
+  SDL_GetWindowSizeInPixels(window_, &width, &height);
+  TouchEvent::Action action;
+  switch (event.type) {
+    case SDL_EVENT_FINGER_DOWN:
+      action = TouchEvent::Action::kDown;
+      break;
+    case SDL_EVENT_FINGER_UP:
+      action = TouchEvent::Action::kUp;
+      break;
+    case SDL_EVENT_FINGER_CANCELED:
+      action = TouchEvent::Action::kCancel;
+      break;
+    default:
+      action = TouchEvent::Action::kMove;
+      break;
+  }
+  TouchEvent e(this, uint32_t(event.tfinger.fingerID), action, event.tfinger.x * float(width),
+               event.tfinger.y * float(height));
+  OnTouchEvent(e, destruction_receiver);
+}
+
+}  // namespace ui
+}  // namespace rex
diff --git a/src/ui/windowed_app_context_sdl.cpp b/src/ui/windowed_app_context_sdl.cpp
new file mode 100644
index 0000000..e392259
--- /dev/null
+++ b/src/ui/windowed_app_context_sdl.cpp
@@ -0,0 +1,192 @@
+/**
+ * ReXGlue SDL3 windowed app context (macOS / iOS).
+ */
+
+#include <rex/ui/windowed_app_context_sdl.h>
+
+#include <cstdio>
+
+#include <rex/assert.h>
+#include <rex/ui/window_sdl.h>
+
+#include <SDL3/SDL.h>
+
+namespace rex {
+namespace ui {
+
+SDLWindowedAppContext::SDLWindowedAppContext() = default;
+
+SDLWindowedAppContext::~SDLWindowedAppContext() {
+  if (sdl_initialized_) {
+    SDL_QuitSubSystem(SDL_INIT_VIDEO | SDL_INIT_EVENTS);
+  }
+}
+
+bool SDLWindowedAppContext::Initialize() {
+  if (sdl_initialized_) {
+    return true;
+  }
+  // Keep the game running at full speed when the window is in the background (matches the other
+  // platforms); the user pauses from inside the game.
+  SDL_SetHint(SDL_HINT_VIDEO_MINIMIZE_ON_FOCUS_LOSS, "0");
+  if (!SDL_InitSubSystem(SDL_INIT_VIDEO | SDL_INIT_EVENTS)) {
+    std::fprintf(stderr, "Failed to initialize SDL video: %s\n", SDL_GetError());
+    return false;
+  }
+  sdl_initialized_ = true;
+  const Uint32 first_event = SDL_RegisterEvents(2);
+  if (!first_event) {
+    std::fprintf(stderr, "Failed to register SDL events: %s\n", SDL_GetError());
+    return false;
+  }
+  pending_functions_event_type_ = first_event;
+  paint_event_type_ = first_event + 1;
+  return true;
+}
+
+void SDLWindowedAppContext::NotifyUILoopOfPendingFunctions() {
+  // Any thread. One queued wake-up is enough: the handler drains every pending function.
+  if (pending_functions_event_queued_.exchange(true)) {
+    return;
+  }
+  SDL_Event event;
+  SDL_zero(event);
+  event.type = pending_functions_event_type_;
+  if (!SDL_PushEvent(&event)) {
+    pending_functions_event_queued_ = false;
+  }
+}
+
+void SDLWindowedAppContext::PlatformQuitFromUIThread() {
+  quit_requested_ = true;
+  // Wake SDL_WaitEvent so the loop notices.
+  SDL_Event event;
+  SDL_zero(event);
+  event.type = SDL_EVENT_QUIT;
+  SDL_PushEvent(&event);
+}
+
+bool SDLWindowedAppContext::ShowSimpleMessageBox(const char* const title,
+                                                const char* const message) {
+  return SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, title, message, nullptr);
+}
+
+void SDLWindowedAppContext::RegisterWindow(uint32_t sdl_window_id, SDLWindow* window) {
+  windows_[sdl_window_id] = window;
+}
+
+void SDLWindowedAppContext::UnregisterWindow(uint32_t sdl_window_id) {
+  windows_.erase(sdl_window_id);
+  paint_queued_.erase(sdl_window_id);
+}
+
+void SDLWindowedAppContext::RequestPaint(uint32_t sdl_window_id) {
+  bool& queued = paint_queued_[sdl_window_id];
+  if (queued) {
+    return;
+  }
+  SDL_Event event;
+  SDL_zero(event);
+  event.type = paint_event_type_;
+  event.user.windowID = sdl_window_id;
+  if (SDL_PushEvent(&event)) {
+    queued = true;
+  }
+}
+
+void SDLWindowedAppContext::RunMainSDLLoop() {
+  if (HasQuitFromUIThread()) {
+    return;
+  }
+  SDL_Event event;
+  while (!quit_requested_) {
+    if (!SDL_WaitEvent(&event)) {
+      continue;
+    }
+    DispatchEvent(event);
+  }
+  // Something other than QuitFromUIThread may have ended the loop (an SDL_EVENT_QUIT from the OS,
+  // e.g. Cmd+Q on macOS): let the context know so pending functions stop being queued.
+  QuitFromUIThread();
+}
+
+void SDLWindowedAppContext::DispatchEvent(const SDL_Event& event) {
+  if (event.type == pending_functions_event_type_) {
+    // Re-arm before draining so a notification during execution is not lost.
+    pending_functions_event_queued_ = false;
+    ExecutePendingFunctionsFromUIThread();
+    return;
+  }
+  if (event.type == paint_event_type_) {
+    paint_queued_[event.user.windowID] = false;
+    auto it = windows_.find(event.user.windowID);
+    if (it != windows_.end()) {
+      it->second->HandlePaintEvent();
+    }
+    return;
+  }
+  if (event.type == SDL_EVENT_QUIT) {
+    // Application-level quit (Cmd+Q, or the iOS app being terminated): close every window, which
+    // lets the app shut the emulation down the same way as closing the window does.
+    if (!quit_requested_) {
+      for (auto it = windows_.begin(); it != windows_.end();) {
+        SDLWindow* window = it->second;
+        ++it;  // Closing may unregister the window.
+        window->HandleQuitRequest();
+      }
+    }
+    return;
+  }
+
+  // Window-targeted events carry the SDL window ID in the same position for every event struct
+  // that has one, but use the typed accessor per category to stay within SDL's documented API.
+  uint32_t window_id = 0;
+  if (event.type >= SDL_EVENT_WINDOW_FIRST && event.type <= SDL_EVENT_WINDOW_LAST) {
+    window_id = event.window.windowID;
+  } else {
+    switch (event.type) {
+      case SDL_EVENT_KEY_DOWN:
+      case SDL_EVENT_KEY_UP:
+        window_id = event.key.windowID;
+        break;
+      case SDL_EVENT_TEXT_INPUT:
+        window_id = event.text.windowID;
+        break;
+      case SDL_EVENT_MOUSE_MOTION:
+        window_id = event.motion.windowID;
+        break;
+      case SDL_EVENT_MOUSE_BUTTON_DOWN:
+      case SDL_EVENT_MOUSE_BUTTON_UP:
+        window_id = event.button.windowID;
+        break;
+      case SDL_EVENT_MOUSE_WHEEL:
+        window_id = event.wheel.windowID;
+        break;
+      case SDL_EVENT_DROP_FILE:
+        window_id = event.drop.windowID;
+        break;
+      case SDL_EVENT_FINGER_DOWN:
+      case SDL_EVENT_FINGER_UP:
+      case SDL_EVENT_FINGER_MOTION:
+      case SDL_EVENT_FINGER_CANCELED:
+        window_id = event.tfinger.windowID;
+        break;
+      default:
+        return;
+    }
+  }
+  auto it = windows_.find(window_id);
+  if (it == windows_.end()) {
+    // Touch events on iOS may arrive without a window ID; route them to the only window.
+    if (windows_.size() == 1 &&
+        (event.type == SDL_EVENT_FINGER_DOWN || event.type == SDL_EVENT_FINGER_UP ||
+         event.type == SDL_EVENT_FINGER_MOTION || event.type == SDL_EVENT_FINGER_CANCELED)) {
+      windows_.begin()->second->HandleEvent(event);
+    }
+    return;
+  }
+  it->second->HandleEvent(event);
+}
+
+}  // namespace ui
+}  // namespace rex
diff --git a/src/ui/windowed_app_main_sdl.cpp b/src/ui/windowed_app_main_sdl.cpp
new file mode 100644
index 0000000..e4e8296
--- /dev/null
+++ b/src/ui/windowed_app_main_sdl.cpp
@@ -0,0 +1,101 @@
+/**
+ * ReXGlue entry point for Apple platforms (macOS / iOS), using SDL3 for the window and event loop.
+ *
+ * Mirrors windowed_app_main_posix.cpp. SDL_main.h turns main() into SDL's app entry, which on
+ * iOS runs UIApplicationMain and calls back into this function.
+ */
+
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <spdlog/common.h>
+
+#include <rex/cvar.h>
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+#include <rex/platform.h>
+#include <rex/ui/windowed_app.h>
+#include <rex/ui/windowed_app_context_sdl.h>
+
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_main.h>
+
+namespace {
+
+// Where the log goes. macOS: beside the executable, as on Linux and Windows. iOS: the app bundle
+// is read-only, so the app's Documents folder (visible in the Files app when the Info.plist sets
+// UIFileSharingEnabled / LSSupportsOpeningDocumentsInPlace).
+std::filesystem::path GetLogFolder() {
+#if defined(TARGET_OS_IOS) && TARGET_OS_IOS
+  if (const char* documents = SDL_GetUserFolder(SDL_FOLDER_DOCUMENTS)) {
+    return std::filesystem::path(documents);
+  }
+#endif
+  return rex::filesystem::GetExecutableFolder();
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  auto init_result = rex::cvar::Init(argc, argv);
+  if (init_result.parse_error) {
+    std::fprintf(stderr,
+                 "WWE '13 could not start: invalid launch option: %s. Check your shortcut or "
+                 "launcher settings.\n",
+                 init_result.parse_error->c_str());
+    return EXIT_FAILURE;
+  }
+  if (init_result.exit_requested) {
+    return EXIT_SUCCESS;
+  }
+  auto remaining = std::move(init_result.remaining);
+  rex::cvar::ApplyEnvironment();
+
+  int result;
+
+  {
+    rex::ui::SDLWindowedAppContext app_context;
+    if (!app_context.Initialize()) {
+      return EXIT_FAILURE;
+    }
+
+    std::unique_ptr<rex::ui::WindowedApp> app = rex::ui::GetWindowedAppCreator()(app_context);
+
+    const auto& option_names = app->GetPositionalOptions();
+    std::map<std::string, std::string> parsed;
+    size_t count = std::min(remaining.size(), option_names.size());
+    for (size_t i = 0; i < count; ++i) {
+      parsed[option_names[i]] = remaining[i];
+    }
+    app->SetParsedArguments(std::move(parsed));
+
+    std::filesystem::path log_path = GetLogFolder() / (app->GetName() + ".log");
+
+    try {
+      rex::InitLogging(log_path.string().c_str());
+    } catch (const spdlog::spdlog_ex& e) {
+      std::fprintf(stderr, "Logging init failed for '%s': %s\n", log_path.string().c_str(),
+                   e.what());
+      rex::InitLogging(nullptr);
+    }
+
+    if (app->OnInitialize()) {
+      app_context.RunMainSDLLoop();
+      result = EXIT_SUCCESS;
+    } else {
+      result = EXIT_FAILURE;
+    }
+
+    app->InvokeOnDestroy();
+  }
+
+  rex::ShutdownLogging();
+
+  return result;
+}
