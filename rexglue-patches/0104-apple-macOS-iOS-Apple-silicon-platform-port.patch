diff --git a/include/rex/ui/window_sdl.h b/include/rex/ui/window_sdl.h
new file mode 100644
index 0000000..15ff74e
--- /dev/null
+++ b/include/rex/ui/window_sdl.h
@@ -0,0 +1,88 @@
+/**
+ * ReXGlue SDL3 window (macOS / iOS).
+ *
+ * An SDL3 window with a CAMetalLayer (SDL_Metal_CreateView), presented by MoltenVK through
+ * VK_EXT_metal_surface. Sizes and mouse coordinates are reported in pixels (backing store), so
+ * Retina displays render at full resolution.
+ */
+
+#pragma once
+
+#include <memory>
+#include <string>
+
+#include <rex/ui/menu_item.h>
+#include <rex/ui/window.h>
+
+struct SDL_Window;
+union SDL_Event;
+
+namespace rex {
+namespace ui {
+
+class SDLWindowedAppContext;
+
+class SDLWindow : public Window {
+  using super = Window;
+
+ public:
+  SDLWindow(WindowedAppContext& app_context, const std::string_view title,
+            uint32_t desired_logical_width, uint32_t desired_logical_height);
+  ~SDLWindow() override;
+
+  SDL_Window* window() const { return window_; }
+  void* GetNativeWindowHandle() const override { return window_; }
+
+  // Called by SDLWindowedAppContext on the UI thread.
+  void HandleEvent(const SDL_Event& event);
+  void HandlePaintEvent();
+  void HandleQuitRequest();
+
+ protected:
+  uint32_t GetLatestDpiImpl() const override;
+
+  bool OpenImpl() override;
+  void RequestCloseImpl() override;
+
+  void ApplyNewFullscreen() override;
+  void ApplyNewTitle() override;
+  void ApplyNewCursorVisibility(CursorVisibility old_cursor_visibility) override;
+  void FocusImpl() override;
+
+  std::unique_ptr<Surface> CreateSurfaceImpl(Surface::TypeFlags allowed_types) override;
+  void RequestPaintImpl() override;
+
+ private:
+  SDLWindowedAppContext& sdl_app_context() const;
+  void ReportActualSize(WindowDestructionReceiver& destruction_receiver);
+  void HandleKeyboard(const SDL_Event& event, WindowDestructionReceiver& destruction_receiver);
+  void HandleMouse(const SDL_Event& event, WindowDestructionReceiver& destruction_receiver);
+  void HandleTouch(const SDL_Event& event, WindowDestructionReceiver& destruction_receiver);
+  void CloseFromSDL();
+  void ApplyCursorHidden(bool hidden);
+
+  SDL_Window* window_ = nullptr;
+  uint32_t window_id_ = 0;
+  // SDL_MetalView (opaque) and its CAMetalLayer.
+  void* metal_view_ = nullptr;
+  void* metal_layer_ = nullptr;
+  // Cursor auto-hide (CursorVisibility::kAutoHidden): hidden until the mouse moves, hidden again
+  // kDefaultCursorAutoHideMilliseconds after the last movement.
+  uint64_t cursor_last_activity_ms_ = 0;
+  bool cursor_hidden_ = false;
+};
+
+class SDLMenuItem : public MenuItem {
+ public:
+  SDLMenuItem(Type type, const std::string& text, const std::string& hotkey,
+              std::function<void()> callback)
+      : MenuItem(type, text, hotkey, std::move(callback)) {}
+
+ protected:
+  // No native menu bar for SDL windows; menus are drawn in-game (ImGui) where needed.
+  void OnChildAdded(MenuItem* child_item) override { (void)child_item; }
+  void OnChildRemoved(MenuItem* child_item) override { (void)child_item; }
+};
+
+}  // namespace ui
+}  // namespace rex
diff --git a/include/rex/ui/windowed_app_context_sdl.h b/include/rex/ui/windowed_app_context_sdl.h
new file mode 100644
index 0000000..292a957
--- /dev/null
+++ b/include/rex/ui/windowed_app_context_sdl.h
@@ -0,0 +1,60 @@
+/**
+ * ReXGlue SDL3 windowed app context (macOS / iOS).
+ *
+ * The UI thread runs SDL's event loop. Other threads wake it with SDL user events (SDL_PushEvent
+ * is thread-safe), which is how pending UI-thread functions and paint requests are delivered.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <unordered_map>
+
+#include <rex/ui/windowed_app_context.h>
+
+union SDL_Event;
+
+namespace rex {
+namespace ui {
+
+class SDLWindow;
+
+class SDLWindowedAppContext final : public WindowedAppContext {
+ public:
+  SDLWindowedAppContext();
+  ~SDLWindowedAppContext();
+
+  // SDL_Init(VIDEO | EVENTS) and event type registration. Call on the main thread before creating
+  // the app; returns false (and logs to stderr) if SDL could not start.
+  bool Initialize();
+
+  void NotifyUILoopOfPendingFunctions() override;
+
+  void PlatformQuitFromUIThread() override;
+
+  bool ShowSimpleMessageBox(const char* title, const char* message) override;
+
+  void RunMainSDLLoop();
+
+  // Window registry for event routing (UI thread only).
+  void RegisterWindow(uint32_t sdl_window_id, SDLWindow* window);
+  void UnregisterWindow(uint32_t sdl_window_id);
+
+  // Coalesced paint request for a window; may be called from the UI thread only.
+  void RequestPaint(uint32_t sdl_window_id);
+
+ private:
+  void DispatchEvent(const SDL_Event& event);
+
+  bool sdl_initialized_ = false;
+  uint32_t pending_functions_event_type_ = 0;
+  uint32_t paint_event_type_ = 0;
+  std::atomic<bool> pending_functions_event_queued_{false};
+  bool quit_requested_ = false;
+  std::unordered_map<uint32_t, SDLWindow*> windows_;
+  std::unordered_map<uint32_t, bool> paint_queued_;
+};
+
+}  // namespace ui
+}  // namespace rex
diff --git a/src/core/CMakeLists.txt b/src/core/CMakeLists.txt
