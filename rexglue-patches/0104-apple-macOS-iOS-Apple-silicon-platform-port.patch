+// Decodes one UTF-8 code point; returns 0 at the end or on malformed input.
+uint32_t NextUtf8CodePoint(const char*& p) {
+  const auto c0 = uint8_t(*p);
+  if (!c0) {
+    return 0;
+  }
+  int extra;
+  uint32_t cp;
+  if (c0 < 0x80) {
+    ++p;
+    return c0;
+  } else if ((c0 & 0xE0) == 0xC0) {
+    extra = 1;
+    cp = c0 & 0x1F;
+  } else if ((c0 & 0xF0) == 0xE0) {
+    extra = 2;
+    cp = c0 & 0x0F;
+  } else if ((c0 & 0xF8) == 0xF0) {
+    extra = 3;
+    cp = c0 & 0x07;
+  } else {
+    return 0;
+  }
+  ++p;
+  for (int i = 0; i < extra; ++i) {
+    const auto c = uint8_t(*p);
+    if ((c & 0xC0) != 0x80) {
+      return 0;
+    }
+    cp = (cp << 6) | (c & 0x3F);
+    ++p;
+  }
+  return cp;
+}
