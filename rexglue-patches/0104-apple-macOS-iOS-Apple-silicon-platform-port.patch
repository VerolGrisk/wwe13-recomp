+bool MetalLayerSurface::GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const {
+  // Size in pixels (backing store), not points: the swapchain must match the layer's drawable.
+  int width = 0, height = 0;
+  if (!window_ || !SDL_GetWindowSizeInPixels(window_, &width, &height) || width <= 0 ||
+      height <= 0) {
+    return false;
+  }
+  width_out = uint32_t(width);
+  height_out = uint32_t(height);
+  return true;
+}
