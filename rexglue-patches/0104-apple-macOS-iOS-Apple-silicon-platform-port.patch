+std::optional<std::u16string> GetClipboardText() {
+  char* text = SDL_GetClipboardText();
+  if (!text) {
+    return std::nullopt;
+  }
+  std::u16string result;
+  const char* p = text;
+  while (uint32_t cp = NextUtf8CodePoint(p)) {
+    if (cp >= 0x10000) {
+      cp -= 0x10000;
+      result.push_back(char16_t(0xD800 + (cp >> 10)));
+      result.push_back(char16_t(0xDC00 + (cp & 0x3FF)));
+    } else {
+      result.push_back(char16_t(cp));
+    }
+  }
+  SDL_free(text);
+  return result;
+}
