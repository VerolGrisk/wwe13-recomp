@@ -76,7 +76,17 @@ target_include_directories(rexcore PRIVATE
 )
 
 if(UNIX)
-    target_link_libraries(rexcore PRIVATE pthread rt dl)
+    if(APPLE)
+        # Darwin has no librt; pthread and dl live in libSystem.
+        target_link_libraries(rexcore PRIVATE pthread dl)
+        # <ucontext.h> (fibers, signal contexts) requires _XOPEN_SOURCE on Darwin; _DARWIN_C_SOURCE
+        # keeps the Darwin extensions (pthread_threadid_np, MAP_ANON, Mach) visible alongside it.
+        # PUBLIC so every ReXGlue library and the game see the same <ucontext.h> layout; third-party
+        # code (SDL's Cocoa backend, FFmpeg) is not affected.
+        target_compile_definitions(rexcore PUBLIC _XOPEN_SOURCE=700 _DARWIN_C_SOURCE=1)
+    else()
+        target_link_libraries(rexcore PRIVATE pthread rt dl)
+    endif()
 elseif(WIN32)
     target_link_libraries(rexcore PRIVATE winmm)
 endif()
