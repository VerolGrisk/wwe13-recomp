@@ -0,0 +1,36 @@
+/**
+ * ReXGlue Apple (macOS / iOS) presentation surface.
+ *
+ * A CAMetalLayer owned by an SDL3 window (SDL_Metal_CreateView / SDL_Metal_GetLayer). MoltenVK
+ * creates the Vulkan surface from the layer with VK_EXT_metal_surface. Kept free of Objective-C so
+ * the presenter can stay plain C++: the layer is an opaque pointer and the drawable size comes
+ * from SDL.
+ */
+
+#pragma once
+
+#include <rex/ui/surface.h>
+
+struct SDL_Window;
+
+namespace rex {
+namespace ui {
+
+class MetalLayerSurface final : public Surface {
+ public:
+  MetalLayerSurface(SDL_Window* window, void* metal_layer) : window_(window), layer_(metal_layer) {}
+  TypeIndex GetType() const override { return kTypeIndex_MetalLayer; }
+  // CAMetalLayer*, as an opaque pointer.
+  void* layer() const { return layer_; }
+  SDL_Window* window() const { return window_; }
+
+ protected:
+  bool GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const override;
+
+ private:
+  SDL_Window* window_;
+  void* layer_;
+};
+
+}  // namespace ui
+}  // namespace rex
