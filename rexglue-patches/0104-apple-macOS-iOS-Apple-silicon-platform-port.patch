+uint32_t SDLWindow::GetLatestDpiImpl() const {
+  if (!window_) {
+    return 0;
+  }
+  // Window coordinates are reported in pixels, so the effective DPI scales with the density.
+  const float density = SDL_GetWindowPixelDensity(window_);
+  return density > 0.0f ? uint32_t(std::lround(GetMediumDpi() * density)) : 0;
+}
