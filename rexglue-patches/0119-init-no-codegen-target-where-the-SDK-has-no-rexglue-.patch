From 87dd7c8991fdb315f7ce1bb455e1257ef99d4666 Mon Sep 17 00:00:00 2001
From: WWE13 Recomp <wwe13-recomp@users.noreply.github.com>
Date: Wed, 25 Nov 2026 04:37:58 -0500
Subject: [PATCH 119/120] init: no codegen target where the SDK has no rexglue
 tool (iOS)

An SDK installed for iOS has no host rexglue program, so $<TARGET_FILE:rex::rexglue>
in the rendered rexglue.cmake failed to generate. The codegen target is now only
defined when rex::rexglue exists; the recompiled sources come from the host build.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 resources/templates/init/rexglue_cmake.inja | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/resources/templates/init/rexglue_cmake.inja b/resources/templates/init/rexglue_cmake.inja
index ae933be..fa38eed 100644
--- a/resources/templates/init/rexglue_cmake.inja
+++ b/resources/templates/init/rexglue_cmake.inja
@@ -63,9 +63,13 @@ macro(rexglue_setup_target target_name)
 endmacro()
 
 # Codegen target - run 'cmake --build . --target {{ names.snake_case }}_codegen'
-add_custom_target({{ names.snake_case }}_codegen
-    COMMAND $<TARGET_FILE:rex::rexglue> codegen {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ names.snake_case }}_config.toml
-    WORKING_DIRECTORY {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}
-    COMMENT "Generating recompiled code for {{ names.snake_case }}"
-    VERBATIM
-)
+# The rexglue tool is a host program: an SDK installed for a device (iOS) has none, and the
+# recompiled sources are generated by the host build instead.
+if(TARGET rex::rexglue)
+    add_custom_target({{ names.snake_case }}_codegen
+        COMMAND $<TARGET_FILE:rex::rexglue> codegen {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ names.snake_case }}_config.toml
+        WORKING_DIRECTORY {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}
+        COMMENT "Generating recompiled code for {{ names.snake_case }}"
+        VERBATIM
+    )
+endif()
