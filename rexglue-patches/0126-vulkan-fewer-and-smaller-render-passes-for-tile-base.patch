+void DeferredCommandBuffer::PatchRenderAreaExtent(size_t arguments_offset, bool is_rendering,
+                                                  VkExtent2D extent) {
+  uintmax_t* arguments = command_stream_.data() + arguments_offset;
+  if (is_rendering) {
+    reinterpret_cast<ArgsVkBeginRendering*>(arguments)->render_area.extent = extent;
+  } else {
+    reinterpret_cast<ArgsVkBeginRenderPass*>(arguments)->render_area.extent = extent;
+  }
