+void VulkanCommandProcessor::OnRenderPassBegun(bool is_rendering, VkExtent2D full_extent) {
+  if (render_area_trim_ < 0) {
+    const char* value = std::getenv("WWE13_RENDER_AREA_TRIM");
+    render_area_trim_ = (value && std::string_view(value) == "0") ? 0 : 1;
+    REXGPU_INFO("Render area trimming is {}",
+                render_area_trim_ ? "on" : "off (WWE13_RENDER_AREA_TRIM=0)");
+  }
+  render_area_arguments_offset_ = deferred_command_buffer_.last_command_arguments_offset();
+  render_area_is_rendering_ = is_rendering;
+  render_area_full_extent_ = full_extent;
+  render_area_used_width_ = 0;
+  render_area_used_height_ = 0;
+  if (!dynamic_scissor_update_needed_) {
+    // The scissor already set in this command buffer applies to the first draws.
+    ExtendRenderArea(dynamic_scissor_);
+  }
+}
+
+void VulkanCommandProcessor::ExtendRenderArea(const VkRect2D& rect) {
+  if (!in_render_pass_ || render_area_arguments_offset_ == SIZE_MAX) {
+    return;
+  }
+  const uint32_t right = uint32_t(std::max(rect.offset.x, 0)) + rect.extent.width;
+  const uint32_t bottom = uint32_t(std::max(rect.offset.y, 0)) + rect.extent.height;
+  render_area_used_width_ = std::max(render_area_used_width_, right);
+  render_area_used_height_ = std::max(render_area_used_height_, bottom);
+}
+
+void VulkanCommandProcessor::OnRenderPassEnding() {
+  if (render_area_arguments_offset_ == SIZE_MAX) {
+    return;
+  }
+  const VkExtent2D full = render_area_full_extent_;
+  VkExtent2D trimmed;
+  trimmed.width = std::clamp(render_area_used_width_, uint32_t(1), full.width);
+  trimmed.height = std::clamp(render_area_used_height_, uint32_t(1), full.height);
+  ++render_area_passes_;
+  render_area_full_pixels_ += uint64_t(full.width) * full.height;
+  render_area_trimmed_pixels_ += uint64_t(trimmed.width) * trimmed.height;
+  if (render_area_passes_ % 50000 == 0) {
+    REXGPU_INFO("Render area trimming: {} passes, {:.1f}% of the full render area kept",
+                render_area_passes_,
+                render_area_full_pixels_
+                    ? 100.0 * double(render_area_trimmed_pixels_) / double(render_area_full_pixels_)
+                    : 100.0);
+  }
+  if (render_area_trim_ > 0 &&
+      (trimmed.width != full.width || trimmed.height != full.height)) {
+    deferred_command_buffer_.PatchRenderAreaExtent(render_area_arguments_offset_,
+                                                   render_area_is_rendering_, trimmed);
+  }
+  render_area_arguments_offset_ = SIZE_MAX;
+}
+
+DeferredCommandBuffer& VulkanCommandProcessor::upload_prelude_command_buffer() {
+  assert_true(submission_open_);
+  if (!upload_prelude_used_) {
+    upload_prelude_used_ = true;
+    // Order the copies after all earlier work on the queue (previous submissions that may still
+    // read or write the shared memory).
+    VkMemoryBarrier prelude_begin_barrier = {};
+    prelude_begin_barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+    prelude_begin_barrier.srcAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+    prelude_begin_barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    upload_prelude_command_buffer_.CmdVkPipelineBarrier(
+        VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1,
+        &prelude_begin_barrier, 0, nullptr, 0, nullptr);
+  }
+  return upload_prelude_command_buffer_;
+}
