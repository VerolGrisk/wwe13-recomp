+void VulkanSharedMemory::ResetTouchedPagesIfNewSubmission() {
+  const uint64_t submission = command_processor_.GetCurrentSubmission();
+  if (submission == touched_submission_) {
+    return;
+  }
+  touched_submission_ = submission;
+  if (touched_pages_.empty()) {
+    touched_pages_.assign(((kBufferSize >> page_size_log2()) + 63) / 64, 0);
+    const char* value = std::getenv("WWE13_UPLOAD_PRELUDE");
+    upload_prelude_enabled_ = !(value && std::string_view(value) == "0");
+    REXGPU_INFO("Shared memory: hoisting uploads out of render passes is {}",
+                upload_prelude_enabled_ ? "on" : "off (WWE13_UPLOAD_PRELUDE=0)");
+  }
+  for (uint32_t block : touched_blocks_) {
+    touched_pages_[block] = 0;
+  }
+  touched_blocks_.clear();
+}
+
+void VulkanSharedMemory::MarkPagesTouched(uint32_t start_bytes, uint32_t length_bytes) {
+  if (!length_bytes) {
+    return;
+  }
+  ResetTouchedPagesIfNewSubmission();
+  const uint32_t page_first = start_bytes >> page_size_log2();
+  const uint32_t page_last = (start_bytes + length_bytes - 1) >> page_size_log2();
+  for (uint32_t page = page_first; page <= page_last;) {
+    const uint32_t block = page >> 6;
+    const uint32_t bit = page & 63;
+    const uint32_t bits = std::min(64 - bit, page_last - page + 1);
+    const uint64_t mask = (bits == 64 ? ~uint64_t(0) : ((uint64_t(1) << bits) - 1)) << bit;
+    if (!touched_pages_[block]) {
+      touched_blocks_.push_back(block);
+    }
+    touched_pages_[block] |= mask;
+    page += bits;
+  }
+}
+
+bool VulkanSharedMemory::ArePagesTouched(uint32_t page_first, uint32_t page_count) {
+  ResetTouchedPagesIfNewSubmission();
+  const uint32_t page_last = page_first + page_count - 1;
+  for (uint32_t page = page_first; page <= page_last;) {
+    const uint32_t block = page >> 6;
+    const uint32_t bit = page & 63;
+    const uint32_t bits = std::min(64 - bit, page_last - page + 1);
+    const uint64_t mask = (bits == 64 ? ~uint64_t(0) : ((uint64_t(1) << bits) - 1)) << bit;
+    if (touched_pages_[block] & mask) {
+      return true;
+    }
+    page += bits;
+  }
+  return false;
+}
