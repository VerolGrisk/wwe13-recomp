diff --git a/src/core/memory_posix.cpp b/src/core/memory_posix.cpp
index 40a1210..e39fede 100644
--- a/src/core/memory_posix.cpp
+++ b/src/core/memory_posix.cpp
@@ -39,13 +39,27 @@
 #endif
 
 #if REX_PLATFORM_MAC
+#include <TargetConditionals.h>
 #include <mach/mach.h>
+#include <mach/vm_map.h>
+#if !TARGET_OS_IOS
 #include <mach/mach_vm.h>
+#endif
 // off_t is always 64-bit on Darwin; there are no separate *64 functions.
 #define ftruncate64 ftruncate
 #define mmap64 mmap
 #endif
 
+// Guest memory backing on Apple: iOS apps cannot use shm_open (the sandbox denies POSIX shared
+// memory), so the guest "page file" is a named Mach memory entry (mach_make_memory_entry_64) and
+// views are vm_map'ed from it. REXGLUE_APPLE_MACH_MEMORY selects this; it is on for iOS and can be
+// turned on for macOS builds to test the iOS path on a Mac.
+#if REX_PLATFORM_MAC && defined(REXGLUE_APPLE_MACH_MEMORY) && REXGLUE_APPLE_MACH_MEMORY
+#define REX_APPLE_MACH_MEMORY 1
+#else
+#define REX_APPLE_MACH_MEMORY 0
+#endif
+
 namespace rex {
 namespace memory {
 
@@ -168,14 +182,28 @@ static bool ParseProcMapsLine(const std::string& line, LinuxMapEntry& out) {
 // Darwin has no /proc/self/maps; mach_vm_region returns the region at or above an address with
 // its current protection, which is filled into the same entry shape as the Linux parser's.
 static bool DarwinRegionAtOrAbove(uintptr_t address, LinuxMapEntry& out) {
-  mach_vm_address_t region_address = address;
-  mach_vm_size_t region_size = 0;
   vm_region_basic_info_data_64_t info;
   mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
   mach_port_t object_name = MACH_PORT_NULL;
-  if (mach_vm_region(mach_task_self(), &region_address, &region_size, VM_REGION_BASIC_INFO_64,
-                     reinterpret_cast<vm_region_info_t>(&info), &count,
-                     &object_name) != KERN_SUCCESS) {
+#if TARGET_OS_IOS
+  // <mach/mach_vm.h> is not part of the iOS SDK; vm_region_64 is the same call with
+  // pointer-sized (64-bit on arm64) addresses.
+  vm_address_t region_address = vm_address_t(address);
+  vm_size_t region_size = 0;
+  const kern_return_t kr =
+      vm_region_64(mach_task_self(), &region_address, &region_size, VM_REGION_BASIC_INFO_64,
+                   reinterpret_cast<vm_region_info_t>(&info), &count, &object_name);
+#else
+  mach_vm_address_t region_address = address;
+  mach_vm_size_t region_size = 0;
+  const kern_return_t kr =
+      mach_vm_region(mach_task_self(), &region_address, &region_size, VM_REGION_BASIC_INFO_64,
+                     reinterpret_cast<vm_region_info_t>(&info), &count, &object_name);
+#endif
+  if (object_name != MACH_PORT_NULL) {
+    mach_port_deallocate(mach_task_self(), object_name);
+  }
+  if (kr != KERN_SUCCESS) {
     return false;
   }
   out = LinuxMapEntry{};
@@ -429,9 +457,46 @@ bool QueryProtect(void* base_address, size_t& length, PageAccess& access_out) {
 #endif
 }
 
+#if REX_APPLE_MACH_MEMORY
+static vm_prot_t ToMachProtect(PageAccess access) {
+  switch (access) {
+    case PageAccess::kReadOnly:
+      return VM_PROT_READ;
+    case PageAccess::kReadWrite:
+      return VM_PROT_READ | VM_PROT_WRITE;
+    case PageAccess::kExecuteReadOnly:
+      return VM_PROT_READ | VM_PROT_EXECUTE;
+    case PageAccess::kExecuteReadWrite:
+      return VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE;
+    case PageAccess::kNoAccess:
+    default:
+      return VM_PROT_NONE;
+  }
+}
+#endif
+
 FileMappingHandle CreateFileMappingHandle(const std::filesystem::path& path, size_t length,
                                           PageAccess access, bool commit) {
-#if REX_PLATFORM_ANDROID
+#if REX_APPLE_MACH_MEMORY
+  // A named memory entry: zero-filled, backed by anonymous (compressible) memory that is only
+  // allocated when touched. Every view vm_map'ed from it shares the same pages.
+  (void)path;
+  (void)access;
+  (void)commit;
+  memory_object_size_t size = memory_object_size_t(length);
+  mach_port_t entry = MACH_PORT_NULL;
+  const kern_return_t kr =
+      mach_make_memory_entry_64(mach_task_self(), &size, 0,
+                                MAP_MEM_NAMED_CREATE | VM_PROT_READ | VM_PROT_WRITE, &entry,
+                                MACH_PORT_NULL);
+  if (kr != KERN_SUCCESS || size < length) {
+    if (entry != MACH_PORT_NULL) {
+      mach_port_deallocate(mach_task_self(), entry);
+    }
+    return kFileMappingHandleInvalid;
+  }
+  return static_cast<FileMappingHandle>(entry);
+#elif REX_PLATFORM_ANDROID
   // TODO(Triang3l): Check if memfd can be used instead on API 30+.
   if (android_ASharedMemory_create_) {
     int sharedmem_fd = android_ASharedMemory_create_(path.c_str(), length);
@@ -488,6 +553,11 @@ FileMappingHandle CreateFileMappingHandle(const std::filesystem::path& path, siz
 }
 
 void CloseFileMappingHandle(FileMappingHandle handle, const std::filesystem::path& path) {
+#if REX_APPLE_MACH_MEMORY
+  (void)path;
+  mach_port_deallocate(mach_task_self(), static_cast<mach_port_t>(handle));
+  return;
+#endif
   close(static_cast<int>(handle));
 #if !REX_PLATFORM_ANDROID
   auto full_path = MakeShmName(path);
@@ -522,6 +592,29 @@ void* MapFileView(FileMappingHandle handle, void* base_address, size_t length, P
     flags |= MAP_FIXED;
   }
 
+#if REX_APPLE_MACH_MEMORY
+  {
+    vm_address_t address = vm_address_t(base_address);
+    const vm_prot_t protection = ToMachProtect(access);
+    // max_protection read/write so later Protect() (mprotect) calls - write watches, MMIO ranges -
+    // can raise access again; copy=FALSE so every view shares the entry's pages.
+    const kern_return_t kr =
+        vm_map(mach_task_self(), &address, vm_size_t(length), 0,
+               base_address ? VM_FLAGS_FIXED : VM_FLAGS_ANYWHERE,
+               static_cast<mem_entry_name_port_t>(handle), memory_object_offset_t(file_offset),
+               FALSE, protection, VM_PROT_READ | VM_PROT_WRITE, VM_INHERIT_NONE);
+    (void)flags;
+    if (kr != KERN_SUCCESS) {
+      return nullptr;
+    }
+    if (base_address && reinterpret_cast<void*>(address) != base_address) {
+      vm_deallocate(mach_task_self(), address, vm_size_t(length));
+      return nullptr;
+    }
+    return reinterpret_cast<void*>(address);
+  }
+#endif
+
   uint32_t prot = ToPosixProtectFlags(access);
   void* result = mmap64(base_address, length, prot, flags, static_cast<int>(handle),
                         static_cast<off_t>(file_offset));
@@ -539,7 +632,13 @@ void* MapFileView(FileMappingHandle handle, void* base_address, size_t length, P
 }
 
 bool UnmapFileView(FileMappingHandle handle, void* base_address, size_t length) {
+#if REX_APPLE_MACH_MEMORY
+  (void)handle;
+  return vm_deallocate(mach_task_self(), vm_address_t(base_address), vm_size_t(length)) ==
+         KERN_SUCCESS;
+#else
   return munmap(base_address, length) == 0;
+#endif
 }
 
 }  // namespace memory
diff --git a/src/ui/windowed_app_context_sdl.cpp b/src/ui/windowed_app_context_sdl.cpp
index 1b4ef0a..eef1d97 100644
--- a/src/ui/windowed_app_context_sdl.cpp
+++ b/src/ui/windowed_app_context_sdl.cpp
@@ -16,8 +16,25 @@ namespace ui {
 
 SDLWindowedAppContext::SDLWindowedAppContext() = default;
 
+bool SDLWindowedAppContext::AppLifecycleWatch(void* userdata, SDL_Event* event) {
+  auto* context = static_cast<SDLWindowedAppContext*>(userdata);
+  switch (event->type) {
+    case SDL_EVENT_WILL_ENTER_BACKGROUND:
+    case SDL_EVENT_DID_ENTER_BACKGROUND:
+      context->in_background_ = true;
+      break;
+    case SDL_EVENT_DID_ENTER_FOREGROUND:
+      context->in_background_ = false;
+      break;
+    default:
+      break;
+  }
+  return true;  // the event is still queued as usual
+}
+
 SDLWindowedAppContext::~SDLWindowedAppContext() {
   if (sdl_initialized_) {
+    SDL_RemoveEventWatch(AppLifecycleWatch, this);
     SDL_QuitSubSystem(SDL_INIT_VIDEO | SDL_INIT_EVENTS);
   }
 }
@@ -41,6 +58,7 @@ bool SDLWindowedAppContext::Initialize() {
   }
   pending_functions_event_type_ = first_event;
   paint_event_type_ = first_event + 1;
+  SDL_AddEventWatch(AppLifecycleWatch, this);
   return true;
 }
 
@@ -132,12 +150,23 @@ void SDLWindowedAppContext::DispatchEvent(const SDL_Event& event) {
       std::lock_guard<std::mutex> lock(paint_queued_mutex_);
       paint_queued_[event.user.windowID] = false;
     }
+    if (in_background_) {
+      // No GPU work while the app is in the background (iOS); repainted on return.
+      return;
+    }
     auto it = windows_.find(event.user.windowID);
     if (it != windows_.end()) {
       it->second->HandlePaintEvent();
     }
     return;
   }
+  if (event.type == SDL_EVENT_DID_ENTER_FOREGROUND) {
+    for (const auto& [window_id, window] : windows_) {
+      (void)window;
+      RequestPaint(window_id);
+    }
+    return;
+  }
   if (event.type == SDL_EVENT_QUIT) {
     // Application-level quit (Cmd+Q, or the iOS app being terminated): close every window, which
     // lets the app shut the emulation down the same way as closing the window does.
