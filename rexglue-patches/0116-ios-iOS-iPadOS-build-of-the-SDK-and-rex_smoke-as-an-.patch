 cmake/ios/Info.plist.in                   |  82 ++++++++++++++++
 cmake/ios/app.entitlements                |  16 ++++
 cmake/rexglue_install.cmake               |  15 ++-
 include/rex/platform/dynlib.h             |  12 +++
 include/rex/ui/windowed_app_context_sdl.h |   5 +
 src/core/CMakeLists.txt                   |  12 +++
