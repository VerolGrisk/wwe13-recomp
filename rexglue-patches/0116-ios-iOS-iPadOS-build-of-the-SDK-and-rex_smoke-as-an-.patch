+// --- platform checks (address space, memory limit, fibers) -------------------------------------
+
+}  // namespace
+
+#if REX_PLATFORM_MAC
+#include <mach/mach.h>
+#if defined(TARGET_OS_IOS) && TARGET_OS_IOS
+#include <os/proc.h>
+#endif
+#endif
+
+namespace {
+
+struct PlatformCheck {
+  // Address range the process may map (Apple: task_vm_info). Without the extended virtual
+  // addressing entitlement iOS caps it, and the ~4.5 GB guest reservation may not fit.
+  uint64_t min_address = 0;
+  uint64_t max_address = 0;
+  // Memory the system still lets this process use (iOS: os_proc_available_memory), in bytes.
+  uint64_t available_memory = 0;
+  bool fiber_ok = false;
+};
+
+void FiberEntry(void* arg) {
+  auto* state = static_cast<std::pair<rex::thread::Fiber*, int>*>(arg);
+  state->second += 1;
+  rex::thread::Fiber::SwitchTo(state->first);
+  state->second += 1;
+  rex::thread::Fiber::SwitchTo(state->first);
+}
+
+PlatformCheck RunPlatformCheck() {
+  PlatformCheck check;
+#if REX_PLATFORM_MAC
+  task_vm_info_data_t vm_info{};
+  mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+  if (task_info(mach_task_self(), TASK_VM_INFO, reinterpret_cast<task_info_t>(&vm_info), &count) ==
+      KERN_SUCCESS) {
+    check.min_address = vm_info.min_address;
+    check.max_address = vm_info.max_address;
+  }
+#if defined(TARGET_OS_IOS) && TARGET_OS_IOS
+  check.available_memory = os_proc_available_memory();
+#endif
+#endif
+  // Fibers (ucontext on POSIX): a round trip on a helper thread, so a failure cannot take the UI
+  // thread's context with it.
+  std::thread([&check] {
+    auto* main_fiber = rex::thread::Fiber::ConvertCurrentThread();
+    std::pair<rex::thread::Fiber*, int> state(main_fiber, 0);
+    auto* fiber = rex::thread::Fiber::Create(256 * 1024, FiberEntry, &state);
+    if (main_fiber && fiber) {
+      rex::thread::Fiber::SwitchTo(fiber);
+      rex::thread::Fiber::SwitchTo(fiber);
+      check.fiber_ok = state.second == 2;
+      fiber->Destroy();
+    }
+  }).join();
+  return check;
+}
+
 // --- UI -----------------------------------------------------------------------------------------
 
